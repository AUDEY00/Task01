# Copy to .env only if you do not already have one, then replace placeholders.
# VITE_ values are included in the browser bundle. Do not put private secrets here.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Public Mapbox token for the Mapbox view and GIS overlays.
VITE_MAPBOX_ACCESS_TOKEN=your_public_mapbox_token

# Required when uploading staff profile images.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
